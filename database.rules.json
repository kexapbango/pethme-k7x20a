{
  "rules": {
    "codes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid)",
        ".validate": "newData.isString() && newData.val() === auth.uid"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "requests": {
          "$from": {
            ".write": "auth != null && (auth.uid === $from || auth.uid === $uid)",
            ".validate": "newData.hasChildren(['ts','nick']) && newData.child('ts').isNumber() && newData.child('nick').isString() && newData.child('nick').val().length <= 20"
          }
        }
      }
    },
    "rooms": {
      "$rid": {
        ".read": "auth != null && data.child('members').child(auth.uid).exists()",
        "members": {
          "$m": {
            ".write": "auth != null && auth.uid === $m && $rid.contains(auth.uid)",
            ".validate": "newData.val() === true"
          }
        },
        "state": {
          ".write": "auth != null && root.child('rooms').child($rid).child('members').child(auth.uid).exists()"
        },
        "pets": {
          "$pid": {
            ".write": "auth != null && root.child('rooms').child($rid).child('members').child(auth.uid).exists()"
          }
        },
        "photos": {
          "$p": {
            ".write": "auth != null && root.child('rooms').child($rid).child('members').child(auth.uid).exists()"
          }
        },
        "live": {
          ".write": "auth != null && root.child('rooms').child($rid).child('members').child(auth.uid).exists()"
        },
        "hold": {
          ".write": "auth != null && root.child('rooms').child($rid).child('members').child(auth.uid).exists()",
          ".validate": "newData.hasChildren(['id','x','y','on','by','ts']) && newData.child('by').val() === auth.uid"
        },
        "fx": {
          "$k": {
            ".write": "auth != null && root.child('rooms').child($rid).child('members').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['t','id','by']) && newData.child('by').val() === auth.uid"
          }
        },
        "furn": {
          ".write": "auth != null && root.child('rooms').child($rid).child('members').child(auth.uid).exists()"
        },
        "messages": {
          "$id": {
            ".write": "auth != null && root.child('rooms').child($rid).child('members').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['from','text','ts']) && newData.child('from').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length <= 500"
          }
        }
      }
    }
  }
}